# InterClue Environment Configuration
APP_NAME=InterClue
APP_TAGLINE="Practice Smarter. Interview Better."
ENVIRONMENT=development
SECRET_KEY=interclue-super-secret-key-production-ready-2026-secure-jwt

# Database: SQLite for zero-config local run, or Neon PostgreSQL in cloud
# DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/interclue?sslmode=require
DATABASE_URL=sqlite:///./interclue.db

# Redis Caching (Optional - falls back seamlessly to in-memory TTL cache)
REDIS_URL=redis://localhost:6379/0

# Gemini API Integration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Speech to Text Providers
DEEPGRAM_API_KEY=
WHISPER_API_KEY=
ASSEMBLYAI_API_KEY=

# App limits
FREE_INTERVIEWS_PER_DAY=3
